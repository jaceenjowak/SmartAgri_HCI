# Backend-only configuration. Never place Supabase secret keys in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Use true for UI/database simulation OR false for real ESP32 hardware mode.
ENABLE_SIMULATION=false

# ESP32 device credentials: set the SAME ID and key in firmware.
# Generate a random key of at least 32 characters and never commit/share it.
IOT_DEVICE_ID=smartagri-esp32-001
IOT_DEVICE_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# ID of the SmartAgri user account that owns this physical device (public.users.id).
IOT_USER_ID=1
# Optional: maximum age of latest device sensor heartbeat before ON is rejected (milliseconds).
IOT_SENSOR_MAX_AGE_MS=30000
